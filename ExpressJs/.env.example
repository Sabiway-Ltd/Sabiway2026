PORT=5000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
MAX_SOCKETS_PER_USER=5

# Must match Django SIMPLE_JWT SIGNING_KEY (SECRET_KEY) so Socket.IO can validate access tokens.
JWT_SIGNING_KEY=replace-with-django-jwt-signing-key

# Shared only between Django and the realtime service for server-to-server broadcasts.
INTERNAL_BROADCAST_TOKEN=replace-with-a-long-random-token
